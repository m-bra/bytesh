    *** 264,274 ****
      
      	int pp =  preprocessor;
      	int np = !preprocessor;
      	np&&fnct&&fputs(mf("void %s()%c", ident, *NLS), f);
      	np&&fnct&&fputs(   mf("{%c", *NLS),      f);
    ! 	np&&     fputs(       szdefb, f);
      	np&&fnct&&fputs(   mf("}%c", *NLS),      f);
      	pp&&fnct&&fputs(mf("#define %s %s%c", ident, szdefb, *NLS), f);
      }
      
      #undef programm
